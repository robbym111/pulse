# Reddit needs no credentials (public RSS feeds).

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 key — https://console.cloud.google.com
YOUTUBE_API_KEY=

# TikTok ms_token — set by tiktok_setup.py
TIKTOK_MS_TOKEN=

# Optional: Brave Search API key (social_search_source.py)
BRAVE_API_KEY=
